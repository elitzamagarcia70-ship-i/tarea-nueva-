# Cadena de conexión de Neon/Postgres (Vercel la crea sola al conectar la base)
DATABASE_URL=postgres://usuario:clave@host/neondb?sslmode=require
# Token de Vercel Blob (Vercel lo crea solo al conectar el Blob store)
BLOB_READ_WRITE_TOKEN=
# Cadena larga y aleatoria para firmar la sesión (mínimo 16 caracteres)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
